# ============================================================
#  صلة تون · متغيرات البيئة
#  انسخ هذا الملف إلى .env محليًا، وأضف نفس القيم في Netlify
#  (Site settings → Environment variables) — لا تضعها في Git أبدًا.
# ============================================================

# قاعدة البيانات (Neon) — pooled للاستخدام العادي
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/selahtone?sslmode=require&pgbouncer=true&connect_timeout=15"
# اتصال مباشر — يستخدمه Prisma للترحيلات (db push / migrate)
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/selahtone?sslmode=require"

# سر توقيع الجلسات — ولّده بالأمر:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET="ضع-هنا-قيمة-عشوائية-طويلة-48-بايت"

# إعدادات العملة والضريبة الافتراضية
DEFAULT_CURRENCY="EGP"
APP_NAME="صلة تون"

# التخزين (Cloudflare R2) — يُستخدم في الخطوة 3 لمرفقات المصروفات
R2_ENDPOINT=""
R2_BUCKET=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
