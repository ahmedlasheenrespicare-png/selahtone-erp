// ============================================================
//  صلة تون — مخطط قاعدة البيانات (Prisma)
//  يقابل ملفي SQL: schema-selah-tone.sql + selah-tone-inventory-tax.sql
//  التصميم: مستودع لكل فرع · حركات مخزون لا تُعدّل · محرك ضريبة متعدد المكوّنات
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------------- التنظيم والوصول -----------------------------
enum RoleCode {
  MANAGER
  ACCOUNTANT
  CS_AGENT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model Branch {
  id            BigInt     @id @default(autoincrement())
  code          String     @unique @db.VarChar(8) // ARH / SHM / BID
  nameAr        String     @map("name_ar") @db.VarChar(120)
  city          String?    @db.VarChar(80)
  phone         String?    @db.VarChar(30)
  invoicePrefix String     @map("invoice_prefix") @db.VarChar(6)
  openingDate   DateTime?  @map("opening_date") @db.Date
  isActive      Boolean    @default(true) @map("is_active")
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz
  users         User[]
  warehouses    Warehouse[]
  commerceSales CommerceSale[]

  @@map("branches")
}

model User {
  id           BigInt      @id @default(autoincrement())
  branchId     BigInt?     @map("branch_id")
  roleCode     RoleCode    @map("role_code")
  fullName     String      @map("full_name") @db.VarChar(120)
  email        String      @unique @db.VarChar(160)
  phone        String?     @db.VarChar(30)
  passwordHash       String      @map("password_hash")
  status             UserStatus  @default(ACTIVE)
  mustChangePassword Boolean     @default(true) @map("must_change_password")
  /// نطاق القائمة: FULL أو LIMITED. LIMITED يقيّد الحساب بلوحة القيادة والمبيعات والمصروفات.
  menuScope               String         @default("FULL") @map("menu_scope") @db.VarChar(16)
  /// صلاحية إلغاء البيع يملكها المحاسب افتراضيًا، ويسحبها المدير متى شاء بلا حذف الحساب.
  canCancelSales          Boolean        @default(true) @map("can_cancel_sales")
  lastLoginAt        DateTime?   @map("last_login_at") @db.Timestamptz
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz
  branch             Branch?     @relation(fields: [branchId], references: [id])
  sessions           AuthSession[]
  loginAttempts      LoginAttempt[]
  inventoryOpenings  InventoryOpening[]
  inventoryReceipts  InventoryReceipt[]
  productCreations   InventoryProductCreation[]
  commerceSales      CommerceSale[]
  commerceCollections CommerceCollection[]
  commerceReturns    CommerceReturn[]
  commerceRefunds    CommerceRefund[]
  commerceSettingChanges CommerceSettingsChange[]
  commerceSettingsUpdates CommerceSettings[]
  salesCategoriesCreated  SalesItemCategory[] @relation("SalesCategoryCreatedBy")
  salesCategoriesUpdated  SalesItemCategory[] @relation("SalesCategoryUpdatedBy")
  salesTypesCreated       SalesItemType[]     @relation("SalesTypeCreatedBy")
  salesTypesUpdated       SalesItemType[]     @relation("SalesTypeUpdatedBy")
  salesFieldsCreated      SalesItemField[]    @relation("SalesFieldCreatedBy")
  salesFieldsUpdated      SalesItemField[]    @relation("SalesFieldUpdatedBy")
  salesCatalogAudits      SalesCatalogAudit[]

  @@index([branchId])
  @@map("users")
}

// جلسات منفصلة لكل جهاز؛ يمكن إلغاء جلسة واحدة دون الاعتماد على صلاحية JWT فقط.
model AuthSession {
  id        String   @id @db.VarChar(64)
  userId    BigInt   @map("user_id")
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

enum AuthAttemptResult {
  SUCCESS
  FAILED
  THROTTLED
  PASSWORD_CHANGE_SUCCESS
  PASSWORD_CHANGE_FAILED
  PASSWORD_RESET
}

// لا تُخزّن كلمات المرور أو البريد الصريح في سجل المحاولات.
model LoginAttempt {
  id             BigInt            @id @default(autoincrement())
  identifierHash String            @map("identifier_hash") @db.Char(64)
  userId         BigInt?           @map("user_id")
  result         AuthAttemptResult
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz
  user           User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([identifierHash, createdAt])
  @@index([createdAt])
  @@map("login_attempts")
}

// عدّاد مشترك في قاعدة البيانات، وليس في ذاكرة وظيفة serverless واحدة.
model LoginThrottle {
  key             String    @id @db.Char(64)
  attempts        Int       @default(0)
  windowStartedAt DateTime  @map("window_started_at") @db.Timestamptz
  lockedUntil     DateTime? @map("locked_until") @db.Timestamptz
  updatedAt       DateTime  @map("updated_at") @db.Timestamptz

  @@index([updatedAt])
  @@map("login_throttles")
}

// ----------------------------- الكتالوج الضريبي -----------------------------
enum TaxKind {
  VAT
  SCHEDULE
  WITHHOLDING
  COMPOSITE
  EXEMPT
}

model TaxRate {
  id            Int       @id @default(autoincrement())
  code          String    @unique @db.VarChar(20) // VAT14 / VAT5 / EXEMPT / COMP22
  nameAr        String    @map("name_ar") @db.VarChar(140)
  rate          Decimal   @db.Decimal(6, 3)
  kind          TaxKind   @default(VAT)
  effectiveFrom DateTime  @default(now()) @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  isDefault     Boolean   @default(false) @map("is_default")
  isActive      Boolean   @default(true) @map("is_active")
  products      Product[]
  invoiceTaxes  InvoiceTax[]
  commerceSaleLines CommerceSaleLine[]

  @@map("tax_rates")
}

// ----------------------------- الفروع والمخزون -----------------------------
model Warehouse {
  id         BigInt     @id @default(autoincrement())
  branchId   BigInt     @map("branch_id")
  code       String     @unique @db.VarChar(12)
  nameAr     String     @map("name_ar") @db.VarChar(100)
  isDefault  Boolean    @default(false) @map("is_default")
  holdsStock Boolean    @default(true) @map("holds_stock")
  isActive   Boolean    @default(true) @map("is_active")
  branch     Branch     @relation(fields: [branchId], references: [id])
  stock      StockLevel[]
  openings   InventoryOpening[]
  receipts   InventoryReceipt[]
  commerceSales CommerceSale[]

  @@unique([branchId, nameAr])
  @@map("warehouses")
}

model StockLevel {
  id          BigInt   @id @default(autoincrement())
  warehouseId BigInt   @map("warehouse_id")
  productId   BigInt   @map("product_id")
  qtyOnHand   Decimal  @default(0) @map("qty_on_hand") @db.Decimal(12, 2)
  avgCost     Decimal  @default(0) @map("avg_cost") @db.Decimal(14, 4)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([warehouseId, productId])
  @@map("stock_levels")
}

enum ProductCategory {
  HEARING_AID
  ACCESSORY
  SPARE_PART
  SERVICE
}

model Product {
  id           BigInt          @id @default(autoincrement())
  sku          String          @unique @db.VarChar(40)
  nameAr       String          @map("name_ar") @db.VarChar(180)
  category     ProductCategory
  brand        String?         @db.VarChar(80)
  model        String?         @db.VarChar(80)
  purchaseCost Decimal         @default(0) @map("purchase_cost") @db.Decimal(14, 2)
  salePrice    Decimal         @default(0) @map("sale_price") @db.Decimal(14, 2)
  taxRateId    Int?            @map("tax_rate_id")
  isSerialized Boolean         @default(false) @map("is_serialized")
  isActive     Boolean         @default(true) @map("is_active")
  taxRate      TaxRate?        @relation(fields: [taxRateId], references: [id])
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz
  openings     InventoryOpening[]
  receipts     InventoryReceipt[]
  creation     InventoryProductCreation?
  commerceSaleLines CommerceSaleLine[]

  @@index([category])
  @@map("products")
}

// أرصدة افتتاحية تُسجّل مرة واحدة لكل صنف ومستودع، مع المُدخل والأرقام التسلسلية.
// لا تمثّل هذه الجداول حركات البيع أو النقل؛ تُضاف هذه العمليات في مرحلة لاحقة.
model InventoryOpening {
  id          BigInt   @id @default(autoincrement())
  requestId   String   @unique @map("request_id") @db.Uuid
  requestHash String   @map("request_hash") @db.Char(64)
  warehouseId BigInt   @map("warehouse_id")
  productId   BigInt   @map("product_id")
  quantity    Decimal  @db.Decimal(12, 2)
  unitCost    Decimal  @map("unit_cost") @db.Decimal(14, 4)
  createdById BigInt   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Restrict)
  serials     InventorySerial[]

  @@unique([warehouseId, productId])
  @@index([createdById, createdAt])
  @@map("inventory_openings")
}

// توريد جديد يزيد رصيد الصنف ويحفظ تكلفته ومرجعه؛ لا ينشئ فاتورة مورد.
model InventoryReceipt {
  id              BigInt   @id @default(autoincrement())
  requestId       String   @unique @map("request_id") @db.Uuid
  requestHash     String   @map("request_hash") @db.Char(64)
  warehouseId     BigInt   @map("warehouse_id")
  productId       BigInt   @map("product_id")
  quantity        Decimal  @db.Decimal(12,2)
  unitCost        Decimal  @map("unit_cost") @db.Decimal(14,4)
  sourceReference String?  @map("source_reference") @db.VarChar(180)
  createdById     BigInt   @map("created_by_id")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  warehouse       Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product         Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdBy       User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  serials         InventorySerial[]

  @@index([warehouseId, productId, createdAt])
  @@index([createdById, createdAt])
  @@map("inventory_receipts")
}

model InventorySerial {
  id           BigInt   @id @default(autoincrement())
  openingId    BigInt?  @map("opening_id")
  receiptId    BigInt?  @map("receipt_id")
  currentSaleLineId BigInt? @map("current_sale_line_id")
  serialNumber String   @map("serial_number") @db.VarChar(80)
  serialKey    String   @unique @map("serial_key") @db.VarChar(80)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  opening      InventoryOpening? @relation(fields: [openingId], references: [id], onDelete: Restrict)
  receipt      InventoryReceipt? @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  currentSaleLine CommerceSaleLine? @relation("CurrentSerialSale", fields: [currentSaleLineId], references: [id], onDelete: Restrict)
  saleLinks CommerceSaleLineSerial[]

  // A SQL CHECK requires exactly one source (opening or receipt).
  @@index([openingId])
  @@index([receiptId])
  @@index([currentSaleLineId])
  @@map("inventory_serials")
}

// سجل مستقل لا يغيّر جدول الأصناف الحالي، ويحمي إعادة إرسال طلب الإضافة نفسه.
model InventoryProductCreation {
  id          BigInt   @id @default(autoincrement())
  requestId   String   @unique @map("request_id") @db.Uuid
  requestHash String   @map("request_hash") @db.Char(64)
  productId   BigInt   @unique @map("product_id")
  createdById BigInt   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([createdById, createdAt])
  @@map("inventory_product_creations")
}

// ----------------------------- المصروفات (الخطوة 4) -----------------------------
model ExpenseCategory {
  id        Int       @id @default(autoincrement())
  code      String    @unique @db.VarChar(30)
  nameAr    String    @map("name_ar") @db.VarChar(120)
  isActive  Boolean   @default(true) @map("is_active")
  expenses  Expense[]

  @@map("expense_categories")
}

model Expense {
  id             BigInt   @id @default(autoincrement())
  branchId       BigInt   @map("branch_id")
  categoryId     Int      @map("category_id")
  amount         Decimal  @db.Decimal(14, 2)
  expenseDate    DateTime @map("expense_date") @db.Date
  status         String   @default("DRAFT") @db.VarChar(12)
  requestedById  BigInt   @map("requested_by")
  approvedById   BigInt?  @map("approved_by")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  category       ExpenseCategory @relation(fields: [categoryId], references: [id])

  @@index([branchId, expenseDate])
  @@map("expenses")
}

// ----------------------------- قيود اليومية -----------------------------
model JournalEntry {
  id         BigInt    @id @default(autoincrement())
  entryNo    String    @unique @map("entry_no") @db.VarChar(24)
  entryDate  DateTime  @map("entry_date") @db.Date
  sourceType String    @map("source_type") @db.VarChar(20)
  sourceId   BigInt    @map("source_id")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@unique([sourceType, sourceId])
  @@map("journal_entries")
}

// ----------------------------- الفواتير والضريبة -----------------------------
model Invoice {
  id          BigInt   @id @default(autoincrement())
  invoiceNo   String   @unique @map("invoice_no") @db.VarChar(24)
  branchId    BigInt   @map("branch_id")
  warehouseId BigInt   @map("warehouse_id")
  customerId  BigInt?  @map("customer_id")
  subtotal    Decimal  @default(0) @db.Decimal(14, 2)
  discount    Decimal  @default(0) @db.Decimal(14, 2)
  taxableBase Decimal  @default(0) @map("taxable_base") @db.Decimal(14, 2)
  taxTotal    Decimal  @default(0) @map("tax_total") @db.Decimal(14, 2)
  total       Decimal  @default(0) @db.Decimal(14, 2)
  status      String   @default("DRAFT") @db.VarChar(12)
  createdById BigInt   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  items       InvoiceItem[]
  taxes       InvoiceTax[]

  @@index([branchId, createdAt])
  @@map("invoices")
}

model InvoiceItem {
  id          BigInt  @id @default(autoincrement())
  invoiceId   BigInt  @map("invoice_id")
  productId   BigInt? @map("product_id")
  description String  @db.VarChar(220)
  qty         Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @map("unit_price") @db.Decimal(14, 2)
  taxRateId   Int?    @map("tax_rate_id")
  taxAmount   Decimal @default(0) @map("tax_amount") @db.Decimal(14, 2)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

model InvoiceTax {
  id         BigInt  @id @default(autoincrement())
  invoiceId  BigInt  @map("invoice_id")
  taxRateId  Int     @map("tax_rate_id")
  baseAmount Decimal @map("base_amount") @db.Decimal(14, 2)
  taxAmount  Decimal @map("tax_amount") @db.Decimal(14, 2)
  sequence   Int     @default(1)
  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  taxRate    TaxRate @relation(fields: [taxRateId], references: [id])

  @@index([invoiceId])
  @@map("invoice_taxes")
}

// --------------------- المبيعات المقترحة — للاختبار المعزول فقط ---------------------
// هذه الجداول منفصلة عن Invoice القديم؛ لا تُمثل إقرارًا ضريبيًا أو تحويلاً ماليًا.
model CommerceSettings {
  id               Int      @id @default(1) @db.SmallInt
  // سقف الخصم يسري على كل دور؛ والمدير وحده له سقف أعلى يُضبط من الإعدادات.
  staffDiscountBps Int      @default(500) @map("staff_discount_bps")
  managerDiscountBps Int    @default(2500) @map("manager_discount_bps")
  updatedById      BigInt?  @map("updated_by_id")
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy        User?    @relation(fields: [updatedById], references: [id], onDelete: Restrict)
  @@map("commerce_settings")
}

model CommerceSettingsChange {
  id               BigInt   @id @default(autoincrement())
  requestId        String   @unique @map("request_id") @db.Uuid
  requestHash      String   @map("request_hash") @db.Char(64)
  staffDiscountBps Int      @map("staff_discount_bps")
  managerDiscountBps Int    @default(2500) @map("manager_discount_bps")
  createdById      BigInt   @map("created_by_id")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy        User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  @@index([createdAt])
  @@map("commerce_settings_changes")
}

model CommerceSale {
  id            BigInt   @id @default(autoincrement())
  requestId     String   @unique @map("request_id") @db.Uuid
  requestHash   String   @map("request_hash") @db.Char(64)
  branchId      BigInt   @map("branch_id")
  // المستودع اختياري: مسار البيع بالأصناف الفنية لا يستخدم مخزونًا ولا مستودعًا.
  warehouseId   BigInt?  @map("warehouse_id")
  customerName  String   @map("customer_name") @db.VarChar(180)
  customerPhone String   @map("customer_phone") @db.VarChar(30)
  subtotal      Decimal  @db.Decimal(14, 2)
  discount      Decimal  @db.Decimal(14, 2)
  // الفراغ يعني «الضريبة غير محددة»؛ ليس صفرًا ولا إعفاءً.
  taxableBase   Decimal? @map("taxable_base") @db.Decimal(14, 2)
  taxTotal      Decimal? @map("tax_total") @db.Decimal(14, 2)
  total         Decimal  @db.Decimal(14, 2)
  revision      Int      @default(0)
  cancelledAt   DateTime? @map("cancelled_at") @db.Timestamptz
  createdById   BigInt   @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  warehouse     Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy     User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  lines         CommerceSaleLine[]
  collections   CommerceCollection[]
  returns       CommerceReturn[]
  refunds       CommerceRefund[]
  @@index([branchId, createdAt])
  @@index([createdById, createdAt])
  @@map("commerce_sales")
}

model CommerceSaleLine {
  id                BigInt   @id @default(autoincrement())
  saleId            BigInt   @map("sale_id")
  // بند الأصناف الفنية: لا منتج ولا مستودع، والضريبة غير محددة (فراغ لا صفر).
  productId         BigInt?  @map("product_id")
  catalogTypeId     BigInt?  @map("catalog_type_id")
  categorySnapshot  String?  @map("category_snapshot") @db.VarChar(120)
  typeSnapshot      String?  @map("type_snapshot") @db.VarChar(120)
  details           Json?    @default("{}")
  skuSnapshot       String?  @map("sku_snapshot") @db.VarChar(40)
  nameSnapshot      String   @map("name_snapshot") @db.VarChar(180)
  quantity          Decimal  @db.Decimal(12, 2)
  unitPrice         Decimal  @map("unit_price") @db.Decimal(14, 2)
  taxRateId         Int?     @map("tax_rate_id")
  taxCodeSnapshot   String?  @map("tax_code_snapshot") @db.VarChar(20)
  taxKindSnapshot   String?  @map("tax_kind_snapshot") @db.VarChar(12)
  taxRateSnapshot   Decimal? @map("tax_rate_snapshot") @db.Decimal(6, 3)
  gross             Decimal  @db.Decimal(14, 2)
  discount          Decimal  @db.Decimal(14, 2)
  taxableBase       Decimal? @map("taxable_base") @db.Decimal(14, 2)
  taxAmount         Decimal? @map("tax_amount") @db.Decimal(14, 2)
  total             Decimal  @db.Decimal(14, 2)
  unitCost          Decimal? @map("unit_cost") @db.Decimal(14, 4)
  isStock           Boolean  @map("is_stock")
  isSerialized      Boolean  @map("is_serialized")
  sale              CommerceSale @relation(fields: [saleId], references: [id], onDelete: Restrict)
  product           Product? @relation(fields: [productId], references: [id], onDelete: Restrict)
  catalogType       SalesItemType? @relation(fields: [catalogTypeId], references: [id], onDelete: Restrict)
  taxRate           TaxRate? @relation(fields: [taxRateId], references: [id], onDelete: Restrict)
  serialLinks       CommerceSaleLineSerial[]
  currentSerials    InventorySerial[] @relation("CurrentSerialSale")
  returnLines       CommerceReturnLine[]
  @@unique([saleId, productId])
  @@map("commerce_sale_lines")
}

model CommerceSaleLineSerial {
  id         BigInt @id @default(autoincrement())
  saleLineId BigInt @map("sale_line_id")
  serialId   BigInt @map("serial_id")
  saleLine   CommerceSaleLine @relation(fields: [saleLineId], references: [id], onDelete: Restrict)
  serial     InventorySerial @relation(fields: [serialId], references: [id], onDelete: Restrict)
  returnSerial CommerceReturnSerial?
  @@unique([saleLineId, serialId])
  @@index([serialId])
  @@map("commerce_sale_line_serials")
}

model CommerceCollection {
  id          BigInt   @id @default(autoincrement())
  requestId   String   @unique @map("request_id") @db.Uuid
  requestHash String   @map("request_hash") @db.Char(64)
  saleId      BigInt   @map("sale_id")
  amount      Decimal  @db.Decimal(14, 2)
  method      String   @db.VarChar(16)
  isInitial   Boolean  @default(false) @map("is_initial")
  createdById BigInt   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  sale        CommerceSale @relation(fields: [saleId], references: [id], onDelete: Restrict)
  createdBy   User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  @@index([saleId, createdAt])
  @@map("commerce_collections")
}

model CommerceReturn {
  id             BigInt   @id @default(autoincrement())
  requestId      String   @unique @map("request_id") @db.Uuid
  requestHash    String   @map("request_hash") @db.Char(64)
  saleId         BigInt   @map("sale_id")
  isCancellation Boolean  @default(false) @map("is_cancellation")
  createdById    BigInt   @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  sale           CommerceSale @relation(fields: [saleId], references: [id], onDelete: Restrict)
  createdBy      User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  lines          CommerceReturnLine[]
  @@index([saleId, createdAt])
  @@map("commerce_returns")
}

model CommerceReturnLine {
  id         BigInt  @id @default(autoincrement())
  returnId   BigInt  @map("return_id")
  saleLineId BigInt  @map("sale_line_id")
  quantity   Decimal @db.Decimal(12, 2)
  total      Decimal @db.Decimal(14, 2)
  taxAmount  Decimal @map("tax_amount") @db.Decimal(14, 2)
  returned   CommerceReturn @relation(fields: [returnId], references: [id], onDelete: Restrict)
  saleLine   CommerceSaleLine @relation(fields: [saleLineId], references: [id], onDelete: Restrict)
  serials    CommerceReturnSerial[]
  @@unique([returnId, saleLineId])
  @@index([saleLineId])
  @@map("commerce_return_lines")
}

model CommerceReturnSerial {
  id               BigInt @id @default(autoincrement())
  returnLineId     BigInt @map("return_line_id")
  saleLineSerialId BigInt @unique @map("sale_line_serial_id")
  returnLine       CommerceReturnLine @relation(fields: [returnLineId], references: [id], onDelete: Restrict)
  saleLineSerial   CommerceSaleLineSerial @relation(fields: [saleLineSerialId], references: [id], onDelete: Restrict)
  @@index([returnLineId])
  @@map("commerce_return_serials")
}

// يسجل ردًا تم فعليًا خارج النظام؛ لا ينشئ تحويلًا أو دفعة تلقائية.
model CommerceRefund {
  id          BigInt   @id @default(autoincrement())
  requestId   String   @unique @map("request_id") @db.Uuid
  requestHash String   @map("request_hash") @db.Char(64)
  saleId      BigInt   @map("sale_id")
  amount      Decimal  @db.Decimal(14, 2)
  method      String   @db.VarChar(16)
  createdById BigInt   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  sale        CommerceSale @relation(fields: [saleId], references: [id], onDelete: Restrict)
  createdBy   User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  @@index([saleId, createdAt])
  @@map("commerce_refunds")
}

// --------------------------- أصناف البيع الفنية ---------------------------
// شجرة ثابتة: تصنيف ← نوع ← حقول نصية يكتبها الموظف. لا حذف أبدًا: الإيقاف
// فقط، وكل تغيير يُسجَّل بسببه وقبلَه وبعده في sales_catalog_audit.
model SalesItemCategory {
  id          BigInt   @id @default(autoincrement())
  code        String   @unique @db.VarChar(40)
  nameAr      String   @map("name_ar") @db.VarChar(120)
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdById BigInt?  @map("created_by_id")
  updatedById BigInt?  @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdBy   User?    @relation("SalesCategoryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?    @relation("SalesCategoryUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  types       SalesItemType[]
  @@index([sortOrder, id])
  @@map("sales_item_categories")
}

model SalesItemType {
  id          BigInt   @id @default(autoincrement())
  categoryId  BigInt   @map("category_id")
  nameAr      String   @map("name_ar") @db.VarChar(120)
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdById BigInt?  @map("created_by_id")
  updatedById BigInt?  @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz
  category    SalesItemCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy   User?    @relation("SalesTypeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?    @relation("SalesTypeUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  fields      SalesItemField[]
  saleLines   CommerceSaleLine[]
  @@unique([categoryId, nameAr])
  @@index([categoryId, sortOrder, id])
  @@map("sales_item_types")
}

model SalesItemField {
  id          BigInt   @id @default(autoincrement())
  typeId      BigInt   @map("type_id")
  fieldKey    String   @map("field_key") @db.VarChar(60)
  labelAr     String   @map("label_ar") @db.VarChar(120)
  isRequired  Boolean  @default(true) @map("is_required")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdById BigInt?  @map("created_by_id")
  updatedById BigInt?  @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz
  type        SalesItemType @relation(fields: [typeId], references: [id], onDelete: Restrict)
  createdBy   User?    @relation("SalesFieldCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?    @relation("SalesFieldUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  @@unique([typeId, fieldKey])
  @@index([typeId, sortOrder, id])
  @@map("sales_item_fields")
}

model SalesCatalogAudit {
  id         BigInt   @id @default(autoincrement())
  requestId  String   @unique @map("request_id") @db.Uuid
  entity     String   @db.VarChar(12)
  entityId   BigInt   @map("entity_id")
  action     String   @db.VarChar(12)
  beforeData Json?    @map("before_data")
  afterData  Json?    @map("after_data")
  reason     String   @db.VarChar(300)
  actorId    BigInt   @map("actor_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("sales_catalog_audit")
}
